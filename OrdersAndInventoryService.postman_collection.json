{
  "info": {
    "_postman_id": "8f3b14d2-28a1-4347-8cfb-6f4e1f74811a",
    "name": "Orders and Inventory Service API",
    "description": "Production-ready Postman Collection for testing Orders & Inventory Service (.NET 8 Clean Architecture with SQL Server).",
